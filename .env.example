# Runware image generation (produce_video.py)
RUNWARE_API_KEY=your_runware_api_key_here

# Maton gateway bearer token for Google Drive upload (produce_video.py)
MATON_KEY=your_maton_bearer_token_here

# Path to scripts JSON for the video factory (relative or absolute)
SCRIPTS_FILE=./scripts.example.json

# YouTube OAuth token JSON for YouTubeAuditor.py
YOUTUBE_TOKEN_FILE=./youtube_token.json

# Optional: Gemini API key if using the grader agent with a live client
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama endpoint for shadow-coder
OLLAMA_URL=http://localhost:11434/api/generate
